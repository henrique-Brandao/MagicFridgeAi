API_KEY=

# PostgreSQL defaults used by Docker Compose.
POSTGRES_DB=magicfridge
POSTGRES_USER=magicfridge
POSTGRES_PASSWORD=magicfridge
POSTGRES_PORT=5432

# Backend database connection.
# In Docker Compose, keep host as "db".
# For a local PostgreSQL running on your machine, use jdbc:postgresql://localhost:5432/magicfridge.
DATABASE_URL=jdbc:postgresql://db:5432/magicfridge
DATABASE_USERNAME=magicfridge
DATABASE_PASSWORD=magicfridge

# Browser-facing URLs/ports used by Docker Compose.
VITE_API_URL=http://localhost:8080
BACKEND_PORT=8080
FRONTEND_PORT=5173
